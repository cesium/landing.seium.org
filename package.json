{
  "name": "seium_landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all develop",
    "develop": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "generate": "plop --plopfile generator/plopfile.js",
    "prepare": "husky",
    "fmt": "bunx npm-run-all format",
    "format": "bunx prettier --ignore-path .gitignore '!**/*.hbs' --write .",
    "test": "npm-run-all test:*",
    "test:lint": "npm-run-all test:lint:*",
    "test:lint:js": "eslint .",
    "test:format": "bunx prettier --check . --ignore-path .gitignore '!**/*.hbs'"
  },
  "lint-staged": {
    "**/!(*.hbs)": "prettier --ignore-unknown"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "lottie-react": "^3.1.2",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-cool-inview": "^2.0.8",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "20",
    "@types/qrcode": "^1.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "9",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "plop": "^4.0.5",
    "postcss": "^8.5.32",
    "prettier": "3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.2.7",
    "typescript": "5"
  }
}
